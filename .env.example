APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://kedo:kedo@localhost:5432/kedo?sslmode=disable
JWT_SECRET=change-me-at-least-32-bytes-long
JWT_TTL=24h
SEAL_SECRET=change-me-another-32-bytes-secret
STORAGE_DIR=./data/files
MAX_UPLOAD_BYTES=10485760
PUBLIC_WEB_URL=http://localhost:5173
CORS_ALLOWED_ORIGIN=http://localhost:5173
WEBHOOK_WORKERS=2
# Email (Gmail SMTP with an app password). Leave SMTP_HOST empty to disable delivery.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=<16-character app password>
# MAIL_FROM=you@gmail.com
# Required (>= 32 bytes, distinct from JWT_SECRET and SEAL_SECRET) when SMTP_HOST is set and APP_ENV is not dev.
# EMAIL_OUTBOX_KEY=
EMAIL_WORKERS=2
# host port for the compose Postgres (change if 5432 is taken)
POSTGRES_PORT=5432
TRUST_PROXY=false
